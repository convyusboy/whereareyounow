# Supabase project (from supabase.com dashboard or `supabase status` for local dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC pepper used to hash invitation codes (and future NIM identifiers) before storage.
# Generate with: openssl rand -hex 32
IDENTIFIER_HASH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Placeholder for Phase 2 (Mapbox map UI). Not used yet.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin session idle timeout, enforced in proxy.ts (Supabase has no native per-role TTL).
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=20

# Postgres-backed rate limiting for login / invitation-redemption attempts.
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_ATTEMPT_MAX=5
